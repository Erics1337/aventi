# Public Expo config. These values are bundled into the mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Local HTTP is supported only by development builds. Preview/store builds require public HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional public hCaptcha site key when Supabase Auth CAPTCHA is enabled.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

# Production HTTPS origin hosting Apple/Android association files and auth redirects.
EXPO_PUBLIC_WEB_URL=https://aventi.example
